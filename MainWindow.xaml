<Window x:Class="WinYouTubeMusic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="YouTube Music" Height="768" Width="1280"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Icon="ytmusic.ico"
        Background="#0F0F0F" Foreground="#FFFFFF">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo x:Name="BtnPrevTaskbar" Description="上一首 (Previous)" Click="BtnPrevTaskbar_Click"/>
                <ThumbButtonInfo x:Name="BtnPlayTaskbar" Description="播放/暫停 (Play/Pause)" Click="BtnPlayTaskbar_Click"/>
                <ThumbButtonInfo x:Name="BtnNextTaskbar" Description="下一首 (Next)" Click="BtnNextTaskbar_Click"/>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <Grid MinWidth="600" MinHeight="400">
        <!-- YouTube Music Web View filling entire window -->
        <wv2:WebView2 x:Name="YtmWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="300"/>
    </Grid>
</Window>

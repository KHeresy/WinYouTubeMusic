<Window x:Class="WinYotuTubeMusic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="YouTube Music" Height="768" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F0F" Foreground="#FFFFFF">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo x:Name="BtnPrevTaskbar" Description="上一首 (Previous)" Click="BtnPrevTaskbar_Click"/>
                <ThumbButtonInfo x:Name="BtnPlayTaskbar" Description="播放/暫停 (Play/Pause)" Click="BtnPlayTaskbar_Click"/>
                <ThumbButtonInfo x:Name="BtnNextTaskbar" Description="下一首 (Next)" Click="BtnNextTaskbar_Click"/>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <Grid MinWidth="600" MinHeight="400">
        <Grid.RowDefinitions>
            <!-- Top Header Bar with Album Cover Preview -->
            <RowDefinition Height="70"/>
            <!-- WebView2 Display -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#161616" BorderBrush="#262626" BorderThickness="0,0,0,1">
            <Grid Margin="12,5">
                <Grid.ColumnDefinitions>
                    <!-- Album Cover Container for Taskbar Thumbnail Clip -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Album Cover Image (Target for Taskbar Thumbnail Clip) -->
                <Border x:Name="AlbumCoverBorder" Grid.Column="0" Width="60" Height="60" CornerRadius="6" Background="#222222" ClipToBounds="True" Margin="0,0,12,0">
                    <Grid x:Name="AlbumGrid">
                        <TextBlock x:Name="PlaceholderIcon" Text="🎵" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666666"/>
                        <Image x:Name="AlbumCoverImage" Stretch="UniformToFill"/>
                    </Grid>
                </Border>

                <!-- Currently Playing Song & Artist Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSongTitle" Text="YouTube Music" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtArtistName" Text="尚未播放曲目" FontSize="12" Foreground="#AAAAAA" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Navigation Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnBack" Content="◀" ToolTip="上一頁" Click="BtnBack_Click" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0" Width="36" Height="32" Margin="2,0" FontSize="14"/>
                    <Button x:Name="BtnForward" Content="▶" ToolTip="下一頁" Click="BtnForward_Click" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0" Width="36" Height="32" Margin="2,0" FontSize="14"/>
                    <Button x:Name="BtnReload" Content="🔄" ToolTip="重新整理" Click="BtnReload_Click" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0" Width="36" Height="32" Margin="2,0" FontSize="14"/>
                    <Button x:Name="BtnAlwaysOnTop" Content="📌" ToolTip="釘選置頂" Click="BtnAlwaysOnTop_Click" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0" Width="36" Height="32" Margin="2,0" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- YouTube Music Web View -->
        <wv2:WebView2 x:Name="YtmWebView" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="300"/>
    </Grid>
</Window>
